TMDB_API_KEY=v3_key
TMDB_READ_TOKEN=v4_key

# Раздачи и magnet-ссылки на Rutracker доступны без аккаунта — логин и пароль
# не нужны. Единственная преграда — защита Cloudflare: tracker.php и
# viewtopic.php могут отдавать 403 и requests, и cloudscraper. Обходной путь —
# войти в браузере и перенести оттуда cookies. Значение cf_clearance привязано
# к IP и точной строке User-Agent, поэтому переносить нужно и то, и другое.
RUTRACKER_COOKIES=
RUTRACKER_USER_AGENT=
# Зеркало, если основной домен недоступен (например, https://rutracker.net)
RUTRACKER_DOMAIN=
R2_BUCKET_NAME=название_вашей_корзины
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=ваш_Access_Key_ID
R2_SECRET_ACCESS_KEY=ваш_Secret_Access_Key
# В облако уезжает не рабочая база, а её срез: только фильмы и сериалы с
# раздачами (полный каталог TMDB клиенту не нужен и весит в разы больше).
# Поставьте 0, если клиенту нужен весь каталог целиком.
PUBLIC_DB_ONLY_WITH_TORRENTS=1
# Локальный OpenAI-совместимый сервер модели (Lemonade / LM Studio / Ollama).
# В Docker localhost — это сам контейнер, используйте host.docker.internal.
LLM_BASE_URL=http://localhost:13305/api/v1
LLM_MODEL=Gemma-4-E4B-it-GGUF
LLM_TIMEOUT_SECONDS=180

# Доступ к веб-панели. Если пароль не задан, панель отвечает только на localhost.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Задержка между запросами к трекеру (в секундах, случайное значение в диапазоне).
# Общее значение для всех трекеров:
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=4.0
# Переопределение для конкретного трекера (префикс RUTRACKER_ или NNMCLUB_):
NNMCLUB_REQUEST_DELAY_MIN=1.0
NNMCLUB_REQUEST_DELAY_MAX=4.0

# Ручной подбор раздач в панели: сколько страниц выдачи трекера забирать
# (по 50 строк) и сколько раздач максимум показывать по одному запросу.
SEARCH_MAX_PAGES=4
SEARCH_RESULT_LIMIT=200

# Предохранители обхода. Очередь хранится в БД, поэтому прерванный по лимиту
# прогон продолжится со следующего запуска.
MAX_PAGES_PER_RUN=200
MAX_CRAWL_DEPTH=5
MAX_RUNTIME_SECONDS=3600
